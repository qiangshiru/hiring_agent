APP_NAME="Hiring Agent"
APP_ENV="local"
APP_DEBUG=true
APP_HOST="0.0.0.0"
APP_PORT=8000
API_V1_PREFIX="/api/v1"

LOG_LEVEL="INFO"
LOG_JSON=true

BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

DATABASE_URL="postgresql+asyncpg://hiring_agent:hiring_agent@localhost:5432/hiring_agent"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL="redis://localhost:6379/0"

LLM_PROVIDER="openai"
LLM_API_KEY="replace-me"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
LLM_TIMEOUT_SECONDS=30

MILVUS_HOST="localhost"
MILVUS_PORT=19530
MILVUS_USER=""
MILVUS_PASSWORD=""
MILVUS_COLLECTION="candidate_embeddings"

JD_PARSER_MODE="rule"
JD_PARSER_CACHE_TTL_SECONDS=3600
JD_PARSER_LLM_MAX_RETRIES=2
JD_PARSER_KNOWN_TECH_STACKS='["Python","RAG","LangChain","Agent","FastAPI","Django","Flask","SQLAlchemy","PostgreSQL","Redis","Milvus","Docker","Kubernetes","React","Vue","TypeScript","Java","Go","Rust","TensorFlow","PyTorch"]'
JD_PARSER_BONUS_HINTS='["优先","加分","bonus","plus","nice to have"]'
JD_PARSER_MUST_HINTS='["必须","熟悉","精通","掌握","要求","需要","must","required"]'
JD_PARSER_EDUCATION_TERMS='["博士","硕士","本科","大专","985","211","统招"]'
JD_PARSER_CITY_TERMS='["北京","上海","广州","深圳","杭州","南京","成都","武汉","西安","苏州","远程"]'
