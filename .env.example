APP_NAME="Hiring Agent"
APP_ENV="local"
APP_DEBUG=true
APP_HOST="0.0.0.0"
APP_PORT=8000
API_V1_PREFIX="/api/v1"

LOG_LEVEL="INFO"
LOG_JSON=true

BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

DATABASE_URL="postgresql+asyncpg://hiring_agent:hiring_agent@localhost:5432/hiring_agent"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

REDIS_URL="redis://localhost:6379/0"

LLM_PROVIDER="openai"
LLM_API_KEY="replace-me"
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL=""
LLM_TIMEOUT_SECONDS=30

MILVUS_HOST="localhost"
MILVUS_PORT=19530
MILVUS_USER=""
MILVUS_PASSWORD=""
MILVUS_COLLECTION="candidate_embeddings"
